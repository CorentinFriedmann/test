{
  "name": "estran",
  "version": "0.1.0",
  "private": true,
  "description": "ESTRAN, version courte une maree (T-029)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test:unit": "node scripts/gen-data.mjs && node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/p2.cjs && node tests/e2e/run.cjs && node tests/e2e/render.cjs && node tests/e2e/audio.cjs",
    "test:p2": "node scripts/gen-data.mjs && node --test \"tests/p2/*.test.js\"",
    "p2:report": "node tests/p2/run.mjs",
    "p2:audio-cpu": "node tests/p2/audio-cpu.cjs",
    "p2:timing": "node scripts/gen-data.mjs && node tests/p2/timing.mjs && node scripts/build.mjs && node tests/p2/timing-load.cjs 5",
    "test": "npm run test:unit && npm run test:p2 && npm run test:e2e",
    "all": "npm ci && npm run lint && npm run build && npm test",
    "captures": "node scripts/build.mjs && node scripts/captures.mjs",
    "test:render": "node tests/e2e/render.cjs",
    "test:p2file": "node tests/e2e/p2.cjs",
    "test:audio": "node tests/e2e/audio.cjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.14.0"
  }
}
